{
  "name": "astro-studio",
  "displayName": "Astro Studio",
  "description": "Local-first Astro content forms, live preview, and native Git review inside VS Code.",
  "version": "0.1.0",
  "publisher": "astro-studio-local",
  "private": true,
  "license": "UNLICENSED",
  "preview": true,
  "engines": {
    "vscode": "^1.143.1",
    "node": ">=22.12.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "repository": { "type": "git", "url": "https://github.com/VJ-Ranga/astro-studio.git" },
  "homepage": "https://github.com/VJ-Ranga/astro-studio#readme",
  "bugs": { "url": "https://github.com/VJ-Ranga/astro-studio/issues" },
  "files": ["package.json", "README.md", "CHANGELOG.md", "THIRD_PARTY_NOTICES.txt", "docs/user-guide.md", "dist/extension.cjs", "dist/webview/main.js", "dist/webview/main.css"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Read-only project discovery is available. Project execution will require workspace trust."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "astroStudio.open",
        "title": "Open Studio",
        "category": "Astro Studio"
      },
      {
        "command": "astroStudio.startPreview",
        "title": "Start Preview",
        "category": "Astro Studio"
      },
      {
        "command": "astroStudio.stopPreview",
        "title": "Stop Preview",
        "category": "Astro Studio"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:release": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "npm run build && node scripts/test-integration.mjs",
    "test:preview": "npm run build && node dist/tests/preview/astro-preview.cjs",
    "package": "npm run build:release && node scripts/package.mjs && node scripts/check-package.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:installed": "node scripts/test-installed.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.140.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@azure/identity": "4.13.0",
    "uuid": "11.1.1"
  }
}
